APP_NAME=dynQR
APP_ENV=local
APP_KEY=
APP_DEBUG=false
# Local development only: enables password-free login for the seeded demo
# accounts. It has no effect unless APP_ENV is local or testing.
APP_DEV_QUICK_LOGIN=false
APP_URL=http://dynqr.local:81

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dynqr
DB_USERNAME=dynqr
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in every environment served over HTTPS.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=mailflash
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@dynqr.com"
MAIL_FROM_NAME="${APP_NAME}"

MAILFLASH_URL=http://mailflash.local:8081
MAILFLASH_API_KEY=

# STRIPE_KEY: publishable key (pk_test_... or pk_live_...)
STRIPE_KEY=
# STRIPE_SECRET: secret key (sk_test_... or sk_live_...) — NOT the publishable key
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=
STRIPE_ENTERPRISE_YEARLY_PRICE_ID=
# Required for paid actions. While this is empty, paid actions are refused
# outside local development (they are never applied for free).
STRIPE_PAID_ACTION_PRICE_ID=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Comma-separated proxy IPs/CIDRs, or "*" ONLY when the app is not directly
# reachable. Wrong values let clients spoof their IP via X-Forwarded-For.
TRUSTED_PROXIES=127.0.0.1

# Content-Security-Policy is report-only until set to true.
CSP_ENFORCE=false

PROXY_DOMAIN=go.dynqr.local:81
PROXY_SCHEME=http

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# QR generator engine: v1 = GD (current), v2 = SVG vector renderer + redesigned UI
QR_GENERATOR_ENGINE=v1
